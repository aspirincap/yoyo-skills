# Copy this file to .env in this skill directory, then fill in your values.
# Do not commit, package, or share the real .env file.

# Root URL for an OpenAI-compatible image/video gateway, without a trailing /v1 path.
AD_STORYBOARD_BASE_URL=https://api.example.com

# Provider model IDs. Availability and request shape depend on your gateway.
AD_STORYBOARD_IMAGE_MODEL=gpt-image-1
AD_STORYBOARD_VIDEO_MODEL=seedance-model-id

# API key env names used by the bundled scripts. Fill at least one key.
NEWAPI_API_KEY=
OPENAI_API_KEY=
PRODUCT_UGC_IMAGE_API_KEY=
PRODUCT_UGC_VIDEO_API_KEY=
IMAGE_API_KEY=
VIDEO_API_KEY=

# Optional per-modality overrides. Usually leave these empty and use AD_STORYBOARD_BASE_URL.
# IMAGE_API_BASE_URL=
# VIDEO_API_BASE_URL=
