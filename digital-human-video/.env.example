# 优先推荐运行 `node scripts/dh.js config`，配置会写入 ~/.config/digital-human-video/config.env
DASHSCOPE_API_KEY=sk-your-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
ALI_SCRIPT_MODEL=qwen-plus
ALI_VOICE_TARGET_MODEL=qwen3-tts-vc-2026-01-22
ALI_VOICE_ENROLLMENT_MODEL=qwen-voice-enrollment
ALI_POLL_INTERVAL_MS=15000
ALI_MAX_POLL_ATTEMPTS=80

# 仅在你完全信任自定义 HTTPS 网关时启用；该网关将收到 API Key。
# DASHSCOPE_ALLOW_CUSTOM_BASE_URL=true
