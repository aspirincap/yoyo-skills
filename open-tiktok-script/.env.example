# Copy to .env for per-skill configuration; never commit real credentials.
# For production deployment, replace with the actual intranet service root (HTTP/HTTPS).
VIDEO_ANALYSIS_BASE_URL=https://agentapi.spotmaxtech.com
# production sends no X-API-Key. Set local explicitly for local testing.
VIDEO_ANALYSIS_ENV=production
# Required only in local mode; supply through environment or ignored .env.
VIDEO_ANALYSIS_API_KEY=
