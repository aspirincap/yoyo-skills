# Export these variables in your shell; this file is not loaded automatically.
# Or reuse the aicreative server from ~/.codex/config.toml.
AICREATIVE_MCP_SERVER=aicreative
AICREATIVE_IMAGE_MODEL_ID=2102
AICREATIVE_VIDEO_MODEL_ID=1108
# Outside Codex, set the full endpoint and Token through your secret manager:
# AICREATIVE_MCP_URL=https://aicreative-api-beta.creatiads.com/api/mcp
# AICREATIVE_MCP_TOKEN=
